{
  "name": "@alintever/dsh-plugin-autoqueue",
  "description": "无人值守任务队列插件：丢 .md 进收件箱 → AI 自动执行 → 产出报告",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "docs/*.md",
    "README.md",
    "AGENTS.md",
    "autoqueue-design.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.1.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.1-rc.2 <0.1.2"
  },
  "scripts": {
    "build:client": "esbuild client/src/index.jsx --bundle --outfile=lib/client.js --format=iife --external:react --external:react-dom/client --loader:.css=text --loader:.png=dataurl --define:React=window.__React --tree-shaking=false",
    "build:test-harness": "esbuild tests/harness.jsx --bundle --outfile=tests/.generated/harness.js --loader:.css=text --loader:.png=dataurl",
    "watch:client": "esbuild client/src/index.jsx --bundle --outfile=lib/client.js --format=iife --external:react --external:react-dom/client --loader:.css=text --loader:.png=dataurl --define:React=window.__React --tree-shaking=false --watch=forever",
    "build": "npm run build:client",
    "test": "npm run test:unit",
    "test:unit": "node --test --test-concurrency=1 tests/core.test.js",
    "test:serve": "npm run build:test-harness && node tests/server.js",
    "test:playwright": "playwright test",
    "test:live:ai": "node tests/live-ai-matrix.mjs",
    "test:live:ui": "node tests/live-ui-matrix.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
