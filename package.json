{
  "name": "@alintever/dsh-plugin-autoqueue",
  "description": "无人值守任务队列插件：丢 .md 进收件箱 → AI 自动执行 → 产出报告",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "docs/*.md",
    "README.md",
    "AGENTS.md",
    "autoqueue-design.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.1.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.1-rc.2 <0.1.2"
  },
  "scripts": {
    "build:client": "esbuild client/src/index.jsx --bundle --outfile=lib/client.js --format=iife --external:react --external:react-dom/client --loader:.css=text --define:React=window.__React --tree-shaking=false",
    "watch:client": "esbuild client/src/index.jsx --bundle --outfile=lib/client.js --format=iife --external:react --external:react-dom/client --loader:.css=text --define:React=window.__React --tree-shaking=false --watch=forever",
    "build": "npm run build:client"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
