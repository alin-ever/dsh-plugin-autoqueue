{
  "name": "@deepseek-ai/dsh-plugin-autoqueue",
  "description": "无人值守任务队列插件：丢 .md 进收件箱 → AI 自动执行 → 产出报告",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/*.js", "cordis.patch.yml"],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1",
    "@deepseek-ai/dsh-tools": "^0.1.1"
  }
}